# JVM options for blastp4j, one per line; lines starting with # are comments, and a line starting with "[arch] "
# applies only where uname -m prints arch. bin/jvm-options prints the ones for this machine; bin/blastp4j,
# bin/compare-blastp.sh and the architecture comparison workflow use it, so that all of them run the same
# configuration. Options given later on the command line (BLASTP4J_OPTS, JMH's -jvmArgsAppend) override these.
#
# Compressed object references off on x86-64 only: C2 then has r12 as one more register for the alignment loops (1-3%
# faster gapped stage on an i7-6700HQ, no difference on GitHub's x64 runners). AArch64 reserves its heap base register
# only when the base is not zero, so there they only double the size of references (5% slower gapped stage).
[x86_64] -XX:-UseCompressedOops
# No safepoints in counted loops: C2 then does not strip-mine the alignment loops, which frees registers there.
-XX:-UseCountedLoopSafepoints
# quiet keeps C2 from printing the CompileCommands on stdout.
-XX:CompileCommand=quiet
# The target-frequency optimizer's helpers not inlined: inlined, C2 took about 0.7 s per compile of
# OptimizeTargetFreq.optimize (8 compiles, 5.7 of 20.5 s of C2 time in a full search), and the code was slower. Only
# BLAST's: almostblastp's OptimizeTargetFreqFast is a vector at a time, with small helpers to inline.
-XX:CompileCommand=dontinline,swiss.sib.blastp4j.compo.OptimizeTargetFreq::*
# The query finders' hit inlined into the batch scan on AArch64 (experiment).
[aarch64] -XX:CompileCommand=inline,swiss.sib.blastp4j.seed.WordFinder::hit
# Vector width: the code uses the preferred vectors everywhere, so these choose it. 256 bits on x86-64, also where the
# CPU has AVX-512 (Zen 4, Intel Xeons): there 512-bit vectors were slower (the word scan 10% on a Xeon 8573C), and
# MaxVectorSize keeps AVX-512's instructions and registers at 256 bits, which UseAVX=2 would not. 512 bits on AMD Zen 5
# ([zen5]: AuthenticAMD, CPU family 26, with avx512f), whose AVX-512 units are full width; after the x86-64 line, so
# that it overrides it.
[x86_64] -XX:MaxVectorSize=32
[zen5] -XX:UseAVX=3
[zen5] -XX:MaxVectorSize=64
# The word finder uses the Vector API, an incubator module, which the JVM then reports with a warning on stderr.
--add-modules=jdk.incubator.vector

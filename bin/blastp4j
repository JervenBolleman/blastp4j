#!/usr/bin/env sh
# Runs blastp4j from the jar built by "mvn package"; options as for BLAST+ blastp (see blastp4j -help).
# Uses $JAVA_HOME/bin/java if set, otherwise java from PATH; extra JVM options can be given in $BLASTP4J_OPTS.
# Use a HotSpot JDK (C2): the Graal JIT is much slower on this code (see README). Compressed object references are
# off: C2 then has r12 as one more register for the alignment loops (1-3% faster gapped stage); BLASTP4J_OPTS can
# turn them back on with -XX:+UseCompressedOops.
HERE="$(cd "$(dirname "$0")/.." && pwd)"
JAR="$(ls "$HERE"/target/blastp4j-*.jar 2>/dev/null | grep -v -e sources -e javadoc | head -1)"
if [ -z "$JAR" ]; then
	echo "blastp4j: no jar in $HERE/target; run 'mvn package' first" >&2
	exit 1
fi
JAVA="${JAVA_HOME:+$JAVA_HOME/bin/}java"
exec "$JAVA" -XX:-UseCompressedOops $BLASTP4J_OPTS -jar "$JAR" "$@"
